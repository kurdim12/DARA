{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dara",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],

  // The Cloudflare Vite plugin sets assets.directory from the Vite build output.
  // not_found_handling makes unknown paths serve index.html (SPA routing).
  // run_worker_first sends /api/* to the Worker instead of the asset server.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dara",
      "database_id": "5d224371-080c-48a6-92b4-fa8949870d38",
      "migrations_dir": "./migrations"
    }
  ],

  // Per-IP rate limiting for /api/analyze. If `wrangler deploy` rejects this
  // block on your plan, delete it: the Worker falls back to an in-isolate
  // limiter automatically (see DEPLOY.md).
  "ratelimits": [
    {
      "name": "ANALYZE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // ANTHROPIC_BASE_URL points the engine at a gateway that speaks the Messages
  // API. OpenRouter's is https://openrouter.ai/api — with it set, model ids
  // take a vendor prefix and ANTHROPIC_API_KEY holds the OpenRouter key.
  // Unset, the engine calls api.anthropic.com directly.
  //
  // ANTHROPIC_MODEL_CANDIDATES is the only other list /api/analyze will accept
  // in the X-DARA-Model header, so `npm run eval -- --compare` can put several
  // models through the golden set against one deployment and the numbers can
  // choose. Nothing outside it can be requested.
  "vars": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_MODEL": "openai/gpt-6-astra",
    "ANTHROPIC_MODEL_CANDIDATES": "openai/gpt-5.5,openai/gpt-5.4,anthropic/claude-opus-5",
    // Tried in order when the model above fails fast — rate-limited, gone,
    // or refusing this request shape. Never tried after a timeout: the wall is
    // ten seconds and a timeout has already spent it. Two different vendors on
    // purpose, so one vendor having a bad morning is not the demo's problem.
    "ANTHROPIC_MODEL_FALLBACKS": "anthropic/claude-opus-5,openai/gpt-5.4",
    "ENGINE_THINKING": "disabled",
    "APP_ENV": "production"
  },

  "observability": { "enabled": true }
}
